{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    ":ignoreModulesAndTests",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all",
    "security:only-security-updates",
    ":disableDependencyDashboard",
  ],
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1000, // really, as many as it likes, just concurrent limit
  // Beta - https://docs.renovatebot.com/modules/manager/pre-commit/
  "pre-commit": {
    "enabled": true
  },
}
